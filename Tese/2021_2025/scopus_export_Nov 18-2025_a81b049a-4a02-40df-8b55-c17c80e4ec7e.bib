	title = {FPGA-Implemented Fractal Decoder with Forward Error Correction in Short-Reach Optical Interconnects},
	year = {2022},
	journal = {Entropy},
	volume = {24},
	number = {1},
	pages = {},
	doi = {10.3390/e24010122},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85123214262&doi=10.3390%2Fe24010122&partnerID=40&md5=a7d3ee007ebe42dfbe193c333719c4b7},
	affiliations = {Riga Technical University, Communication Technologies Research Center, Riga, Latvia; Sumy State University, Department of Electronics and Computer Technology, Sumy, Ukraine; Riga Technical University, Institute of Telecommunications, Riga, Latvia; RISE Research Institutes of Sweden AB, Networks Unit, Gothenburg, Sweden; The Royal Institute of Technology (KTH), Department of Applied Physics, Stockholm, Sweden},
	abstract = {Forward error correction (FEC) codes combined with high-order modulator formats, i.e., coded modulation (CM), are essential in optical communication networks to achieve highly efficient and reliable communication. The task of providing additional error control in the design of CM systems with high-performance requirements remains urgent. As an additional control of CM systems, we propose to use indivisible error detection codes based on a positional number system. In this work, we evaluated the indivisible code using the average probability method (APM) for the binary symmetric channel (BSC), which has the simplicity, versatility and reliability of the estimate, which is close to reality. The APM allows for evaluation and compares indivisible codes according to parameters of correct transmission, and detectable and undetectable errors. Indivisible codes allow for the end-to-end (E2E) control of the transmission and processing of information in digital systems and design devices with a regular structure and high speed. This study researched a fractal decoder device for additional error control, implemented in field-programmable gate array (FPGA) software with FEC for short-reach optical interconnects with multilevel pulse amplitude (PAM-M) modulated with Gray code mapping. Indivisible codes with natural redundancy require far fewer hardware costs to develop and implement encoding and decoding devices with a sufficiently high error detection efficiency. We achieved a reduction in hardware costs for a fractal decoder by using the fractal property of the indivisible code from 10% to 30% for different n while receiving the reciprocal of the golden ratio. © 2022 Elsevier B.V., All rights reserved.},
	author_keywords = {Coded modulation; Error-correcting codes; Error-detecting codes; Fractal decoder; Indivisible codes; Short-reach optical interconnects},
	correspondence_address = {S. Matsenko; Communication Technologies Research Center, Riga Technical University, Riga, 1048, Latvia; email: Svitlana.Matsenko@rtu.lv},
