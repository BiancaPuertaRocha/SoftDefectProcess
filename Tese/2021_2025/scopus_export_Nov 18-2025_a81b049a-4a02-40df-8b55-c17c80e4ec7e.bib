	affiliations = {Universität Duisburg-Essen, Duisburg, Germany},
	abstract = {Applications that integrate multiple Application Programming Interfaces (APIs) often face challenges due to data and application heterogeneity, complicating the integration process. Our proposed approach leverages Large Language Models (LLMs) to translate API function calls and responses into natural language, enabling communication between API consumers and providers without requiring them to adhere to the same communication protocols or data formats. By abstracting technical complexities, this approach addresses both syntactic and semantic differences. We outline the potential of LLMs to improve API interoperability and discuss strategies for optimizing performance, reducing overhead, and ensuring system reliability through error detection and correction. © 2025 Elsevier B.V., All rights reserved.},
	author_keywords = {Application Heterogeneity; Application Programming Interface; Data Heterogeneity; Interoperability; Large Language Model},
	keywords = {Application programming interfaces (API); Application programs; Interoperability; Modeling languages; Natural language processing systems; Translation (languages); Application heterogeneity; Applications programming interfaces; Data heterogeneity; Function calls; Integration process; Interface functions; Language model; Large language model; Model based approach; Multiple applications; Semantics},
	correspondence_address = {R. Lehmann; University of Duisburg-Essen, Duisburg, Germany; email: rene.lehmann@uni-due.de},
	publisher = {Association for Computing Machinery, Inc},
