	title = {Robust Spoofing Detection in GNSS-SDR Systems: A Two-Stage Method for Real-Time Signal Integrity},
	year = {2024},
	pages = {},
	doi = {10.1109/ETECTE63967.2024.10823726},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85217371940&doi=10.1109%2FETECTE63967.2024.10823726&partnerID=40&md5=695289a235df8c31534fe46a4ff8c3e7},
	affiliations = {Bahria University, Department of Electrical Engineering, Islamabad, Pakistan},
	abstract = {Securing Global Navigation Satellite System Software-Defined Radio (GNSS-SDR) systems against spoofing attacks is crucial for maintaining the integrity and reliability of positioning, navigation, and timing (PNT) services. Despite advancements in spoofing detection methods, a significant research gap remains in developing effective and efficient techniques that operate in real-time under various conditions. This study addresses this gap by proposing a two-stage spoofing detection technique that integrates In-Band Signal Strength Monitoring (IBSSM) during the acquisition stage and Carrier-to-Noise Density Ratio (C/N0) monitoring during the tracking stage. The proposed methodology employs the Texas Spoofing Test Battery (TEXBAT) datasets, which include GPS L1 C/A signals under both static and dynamic conditions, to evaluate the performance of the detection system. Key findings indicate that the two-stage detection mechanism significantly improves the detection of spoofing attacks, demonstrating enhanced robustness against sophisticated threats. The implications of this research underscore the necessity of incorporating comprehensive spoofing detection methodologies in modern GNSS-SDR systems, particularly in critical applications where security and reliability are paramount. © 2025 Elsevier B.V., All rights reserved.},
