@ARTICLE{Zhao2022,
	author = {Zhao, Li and Wang, Hao and Zhang, Feng},
	title = {Research on VLC-MIMO System Based on Optical Generalized Spatial Modulation; 基于光广义空间调制的 VLC-MIMO 系统研究},
	year = {2022},
	journal = {Zhongguo Jiguang/Chinese Journal of Lasers},
