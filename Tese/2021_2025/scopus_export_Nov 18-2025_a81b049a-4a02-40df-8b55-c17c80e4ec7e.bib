@CONFERENCE{Jagannathan2024,
	author = {Jagannathan, Shyam and Mody, Mihir and Shankar, Prithvi Y.A. and Jesse, Villarreal and Roh, June Chul and Desappan, Kumar and Poddar, Deepak Kumar and Swami, Pramod Kumar},
	title = {Efficient fault tolerant architecture for neural network compute},
	year = {2024},
	journal = {IS and T International Symposium on Electronic Imaging Science and Technology},
	volume = {36},
	number = {17},
	pages = {},
	doi = {10.2352/EI.2024.36.17.AVM-113},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85196556433&doi=10.2352%2FEI.2024.36.17.AVM-113&partnerID=40&md5=4acfe0dcaca8ae5764bf5aa0d35e5d4e},
	affiliations = {Texas Instruments, Embedded Processor Division, Dallas, United States},
	abstract = {With artificial-intelligence (AI) becoming the mainstream approach to solve a myriad of problems across industrial, automotive, medical, military, wearables and cloud, the need for high-performance, low-power embedded devices are stronger than ever. Innovations around designing an efficient hardware accelerator to perform AI tasks also involves making them fault-tolerant to work reliability under varying stressful environmental conditions. These embedded devices could be deployed under varying thermal and electromagnetic interference conditions which require both the processing blocks and on-device memories to recover from faults and provide a reliable quality of service. Particularly in the automotive context [1], ASIL-B compliant AI systems typically implement error-correction-code (ECC) which takes care of single-error-correction, double-error detection (SECDED) faults. ASIL-D based AI systems implement dual lock step compute blocks and builds processing redundancy to reinforce prediction certainty, on top of protecting its memories. Fault-tolerant systems take it one level higher by tripling the processing blocks, where fault detected by one processing element is corrected and reinforced by the other two elements. This becomes a significant silicon area adder and makes the solution an expensive proposition. In this paper we propose novel techniques that can be applied to a typical deep-learning based embedded solution with many processing stages such as memory load, matrix-multiply, accumulate, activation functions and others to build a robust fault tolerant system without linearly tripling compute area and hence the cost of the solution. © 2024 Elsevier B.V., All rights reserved.},
	keywords = {Defects; Electromagnetic pulse; Error correction; Fault tolerance; Medical problems; Quality of service; Artificial intelligence systems; Automotives; Embedded device; Fault- tolerant systems; Fault-tolerant; Fault-tolerant architectures; Hardware accelerators; Low Power; Neural-networks; Performance; Deep learning},
	publisher = {Society for Imaging Science and Technology},
	issn = {24701173},
	language = {English},
	abbrev_source_title = {IS T Intl. Symposium Electronic Imaging Science Technol.},
	type = {Conference paper},
	publication_stage = {Final},
