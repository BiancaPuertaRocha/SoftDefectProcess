	doi = {10.1109/GCAT62922.2024.10924112},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105002227361&doi=10.1109%2FGCAT62922.2024.10924112&partnerID=40&md5=f0e6edc88329a2991ff04371d3744656},
