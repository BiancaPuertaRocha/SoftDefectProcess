@CONFERENCE{Mehta2024,
	author = {Mehta, J.},
	title = {Design One, Build Many (D1BM) Concepts in Engineering, Procurement, and Construction (EPC)},
	year = {2024},
	pages = {},
	doi = {10.2118/222230-MS},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85215088101&doi=10.2118%2F222230-MS&partnerID=40&md5=7b892f69c6234819c6746208e4814c2b},
	affiliations = {Petrofac Limited, United Arab Emirates, Sharjah, United Arab Emirates},
	abstract = {The "Design One, Build Many" concept in Engineering, Procurement, and Construction (EPC) refers to a strategy that involves designing a standard set of components that can be replicated in multiple projects. This approach allows for cost savings and improved efficiency by minimising design and engineering efforts and maximising the use of standard components. Methods, Procedures, Process: Standardisation: The first step is to standardise the design of critical components or systems frequently used in EPC projects. This involves creating a set of standard specifications, drawings, and design guidelines that can be used across multiple projects. Modularisation: The next step is to modularise the design of the standard components, breaking them down into smaller, interchangeable parts, increasing flexibility in the design and reducing the amount of customisation required. Replication: Once the standard components are designed and modularised, they can be replicated across multiple projects. This allows for standardised equipment, materials, and labour, resulting in cost savings and improved efficiency. Results, Observations, Conclusions: Cost Savings: Using standardised components and designs results in cost savings through economies of scale. Reduced design and engineering efforts and increased standard components and labour use also contribute to cost savings. Improved Efficiency: The Design One, Build Many approach reduces the time required for design and engineering efforts and improves project efficiency by standardising components and reducing the need for customisation. Quality Control: Standardisation and replication help improve quality control by reducing the potential for errors and enhancing the predictability of project outcomes. Improved Safety: Standardisation of components and processes enhances safety by reducing potential errors and inconsistencies in construction and operation. Reduced Environmental Impact: Standardised components and designs also reduce the environmental impact of EPC projects by reducing waste and improving energy efficiency. Novel/Additive Information: The Design One, Build Many approach is valuable for achieving cost savings and improved efficiency in EPC projects. This approach can be utilised for offshore oil and gas/renewable energy (HVAC or HVDC platform), green hydrogen/ammonia, and oil and gas onshore projects. E.g. One platform will be designed for the base case with all standard requirements, and an alternate platform will be provided with a base case plus additional platform-specific requirements such as changes in water depth level for jacket design/sand removal unit/wax mitigation arrangement/corrosion inhibitor/gas lift/derating using HIPPS. © 2025 Elsevier B.V., All rights reserved.},
	keywords = {Acceptance tests; Antiknock rating; Budget control; Building codes; Chemical hazards; Cost engineering; Crack detection; Damage detection; Electric codes; Erosion; Error correction; Failure analysis; Fire hazards; Health hazards; High temperature testing; Low temperature testing; Offshore gas well production; Outages; Petroleum tar; Pipeline bends; Pipeline codes; Pressure vessel codes; Reliability analysis; Software reliability; Steam pipelines; Structural analysis; Structural dynamics; Temperature scales; Ventilation codes; Cost saving; Critical component; Customisation; Engineering constructions; Engineering procurement and construction projects; Multiple projects; Oil and gas; Process standardizations; Standard components; Standardized components; Offshore oil well production},
	publisher = {Society of Petroleum Engineers},
	isbn = {9781959025498},
	language = {English},
	abbrev_source_title = {Soc. Pet. Eng. - ADIPEC},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Zitlaw2024,
	author = {Zitlaw, Cliff and Sayeed, Abdullah and Lim, Sin Liang},
	title = {CRC Integration for Enhanced SPI Communication Reliability in Digital Systems},
	year = {2024},
	pages = {},
	doi = {10.1109/MECON62796.2024.10776358},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85215064685&doi=10.1109%2FMECON62796.2024.10776358&partnerID=40&md5=204d361ab35a5abe38d592deeaa9cb39},
	affiliations = {Infineon Technologies, North America, Systems Engineering, Milpitas, United States; Multimedia University, Cyberjaya, Malaysia},
	abstract = {Serial Peripheral Interface (SPI) communication is a fundamental protocol extensively used in digital systems due to its inherent simplicity and versatility. However, ensuring the reliability of data transmission over SPI interfaces is a concern, particularly in contexts where data integrity holds paramount significance, such as automotive and communication systems. This research presents the integration of cyclic redundancy code (CRC) as a strategy to bolster the reliability of SPI communication. In this approach, when data is transmitted, a CRC code is calculated from the transmitted data using a predefined polynomial function. The CRC value is appended to the transmitted data. Upon receipt, the receiving side computes its own CRC code utilizing the same polynomial function and compares it with the received CRC code. A correspondence between the two codes signifies error-free data, while a disparity indicates the presence of errors, prompting either a discarding of the data or an error correction mechanism. The functionality of the CRC-enabled SPI protocol is evaluated using Xilinx Vivado software for simulation. The factors which impact throughput and error detection capability are investigated to analyze the effectiveness of the CRC-integrated system in improving transmission reliability. By embedding CRC within the SPI protocol, this methodology facilitates robust error detection and presents opportunities for potential error correction during data transmission as long as a limited number of bits in the message are corrupted. This framework of CRC integration into SPI bus transactions can be implemented in any digital system. © 2025 Elsevier B.V., All rights reserved.},
	author_keywords = {CRC; Digital Systems; RTL; SPI},
	keywords = {Digital communication systems; Redundancy; Communication reliabilities; Cyclic Redundancy Code; Data-transmission; Digital system; Errors correction; In contexts; Interface protocol; Polynomial functions; RTL; Serial peripheral interface; Data communication systems},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	isbn = {9798331530747},
	language = {English},
	abbrev_source_title = {Multimed. Univ. Eng. Conf., MECON},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1}
}

@CONFERENCE{Yu2024216,
	author = {Yu, Zhongyang and Yan, Yuqian and Guo, Lingxi and Wang, Wei and Xu, Mengmeng and Xu, Hengzhou and Zhu, Hai},
	title = {Optimal Coding Scheme Selection for LoRa-Based Satellite IoT Transmission},
	year = {2024},
	pages = {216 - 221},
	doi = {10.1109/APCC62576.2024.10767970},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85214650888&doi=10.1109%2FAPCC62576.2024.10767970&partnerID=40&md5=af7f270408992de41f438c81dde2bf6c},
	affiliations = {Henan University of Engineering, School of Computer Science, Zhengzhou, China; Henan University of Technology, College of Information Science and Engineering, Zhengzhou, China; North China University of Water Resources and Electric Power, School of Mechanical Engineering, Zhengzhou, China},
	abstract = {Considering the extremely low signal-to-noise ratio (SNR) environment in future satellite internet of Things (IoT) transmission in which the traditional Hamming coded LoRa (Long Range) system in the ground IoT communication is of difficulty to guarantee high reliability, optimal coding scheme selection for the LoRa-based satellite IoT is studied for the first time. In specific, the corresponding system model is described in detail, followed by derivations of two noncoherent detection methods of coded LoRa signals. Subsequently, the channel capacity of the coded LoRa system is provided and used to develop the corresponding relationship between the signal-to-noise ratio (SNR) and the code rate. Based on the obtained relationship and the Monte-Carlo method, it is found that the coded LoRa system with different spreading factors (SFs) can achieve the lowest SNR when the code rate is close to 1/2. Finally, the performance of several coded LoRa systems (including Hamming code, BCH code, RS code, Turbo code, LDPC code and LDGM code with code rates of about 1/2) is compared by means of the Monte-Carlo method. Simulation results show that Turbo or LDPC coded LoRa systems exhibit more than 4.5 dB performance advantages over the Hamming coded LoRa system. © 2025 Elsevier B.V., All rights reserved.},
	keywords = {Channel coding; Forward error correction; Risk assessment; Satellite communication systems; Space time codes; Turbo codes; Code rates; Coding scheme; High reliability; Long range systems; Low signal-to-noise ratio; MonteCarlo methods; Optimal coding; Performance; Range-based; Satellite internet; Signal to noise ratio},
	correspondence_address = {Z. Yu; Henan University of Engineering, School of Computer Science, Zhengzhou, China; email: xd_yzy2013@sina.com},
