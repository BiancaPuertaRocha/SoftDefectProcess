@ARTICLE{Lou2022377,
	author = {Lou, Yiling and Zhang, Lingming and Hao, Dan and Zhang, Haotian and Zhang, Lu},
	title = {Accelerating Unified Debugging via Adaptive Inference; 自适应推导下的统一化调试加速技术},
	year = {2022},
	journal = {Ruan Jian Xue Bao/Journal of Software},
	volume = {33},
