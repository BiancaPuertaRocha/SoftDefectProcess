	author = {Alsaedi, Shatha Abed and Noaman, Amin Yousef Mohammad and Ahmed, Asaad A.A. and Eassa, Fathy Elbouraey and Haridi, Seif},
	title = {Leveraging Large Language Models for Automated Bug Fixing},
	year = {2024},
	journal = {International Journal of Advanced Computer Science and Applications},
	volume = {15},
	number = {12},
