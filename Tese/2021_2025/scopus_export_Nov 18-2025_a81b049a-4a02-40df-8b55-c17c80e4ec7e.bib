@ARTICLE{Chen20242045,
	author = {Chen, Jue and Wang, Tsangyi and Wu, Jwo Yuh and Li, Chihpeng and Ng, Soon Xin and Maunder, Robert G. and Hanzo, Lajos},
	title = {Deep Learning Aided LLR Correction Improves the Performance of Iterative MIMO Receivers},
	year = {2024},
	journal = {IEEE Transactions on Vehicular Technology},
	volume = {73},
	number = {2},
	pages = {2045 - 2060},
	doi = {10.1109/TVT.2023.3312029},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85171579087&doi=10.1109%2FTVT.2023.3312029&partnerID=40&md5=8410e3fe41543b4c40d0af1b28b9b6c8},
	affiliations = {University of Southampton, Southampton, United Kingdom; National Yang Ming Chiao Tung University, Institute of Communications Engineering, Hsinchu, Taiwan; National Sun Yat-Sen University, Institute of Communications Engineering, Kaohsiung, Taiwan; National Science and Technology Council, Taipei, Taiwan},
	abstract = {A Deep Learning (DL) aided Logarithmic Likelihood Ratio (LLR) correction method is proposed for improving the performance of Multiple-Input Multiple-Output (MIMO) receivers, where it is typical to adopt reduced-complexity algorithms for avoiding the excessive complexity of optimal full-search algorithms. These sub-optimal techniques typically express the probabilities of the detected bits using LLRs that often have values that are not consistent with their true reliability, either expressing too much confidence or not enough confidence in the value of the corresponding bits, leading to performance degradation. To circumvent this problem, a Deep Neural Network (DNN) is trained for detecting and correcting both over-confident and under-confident LLRs. We demonstrate that the complexity of employing the DL-aided technique is relatively low compared to the popular reduced-complexity receiver detector techniques since it only depends on a small number of real-valued inputs. Furthermore, the proposed approach is applicable to a wild variety of iterative receivers as demonstrated in the context of an iterative detection and decoding aided MIMO system, which uses a low-complexity Smart Ordering and Candidate Adding (SOCA) scheme for MIMO detection and Low-Density Parity Check (LDPC) codes for channel coding. We adopt Extrinsic Information Transfer (EXIT) charts for quantifying the Mutual Information (MI) and show that our DL method significantly improves the BLock Error Rate (BLER). Explicitly, we demonstrate that about 0.9 dB gain can be achieved at a BLER of 10-3 by employing the proposed DL-aided LLR correction method, at the modest cost of increasing the complexity by 16% compared to a benchmarker dispensing with LLR correction. © 2024 Elsevier B.V., All rights reserved.},
	author_keywords = {DL; iterative detection and decoding; LDPC codes; LLR; MIMO},
	keywords = {Channel coding; Complex networks; Computational complexity; Deep neural networks; Forward error correction; Lunar surface analysis; MIMO systems; Satellite communication systems; Turbo codes; Benchmark testing; Complexity theory; Deep learning; Iterative decodings; Iterative detection and decoding; Logarithmic likelihood ratios; Low-density parity-check codes; Multiple inputs; Multiple outputs; Multiple-input multiple-output; Multiple-input multiple-output communications; Iterative decoding},
