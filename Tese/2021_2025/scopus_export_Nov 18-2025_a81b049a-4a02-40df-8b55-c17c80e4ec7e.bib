@CONFERENCE{Ma2024,
	author = {Ma, Ning and Liu, Wenqiang and Yang, Haonan and Shi, Linjun and Liu, Zhigang and Shan, Xiangyu},
	title = {WaveFA-Net: Bearing Fault Diagnosis Model Based on Multi-Domain Blind Deconvolution and Frequency Domain Attention Mechanism},
	year = {2024},
	pages = {},
	doi = {10.1109/ICSMD64214.2024.10920532},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105001673774&doi=10.1109%2FICSMD64214.2024.10920532&partnerID=40&md5=88ef64d7d56da6873d3a085ff09bc654},
	affiliations = {Southwest Jiaotong University, Chengdu, China; The Hong Kong Polytechnic University, Hong Kong, Hong Kong; The Hong Kong Polytechnic University, Chinese National Rail Transit Electrification and Automation Engineering Technology Research Centre, Hong Kong, Hong Kong},
	abstract = {Bearings are critical to mechanical systems, impacting reliability, safety, and efficiency. Traditional fault detection methods relying on vibration signal sensors face challenges with multi-scale, nonlinear, and noisy data, affecting performance and accuracy. This paper presents WaveFA-Net, a deep neural network integrating multi-resolution decomposition, frequency attention, multi-domain blind deconvolution, and attention mechanisms to improve diagnostic accuracy. The process begins with applying a discrete wavelet transform (DWT) for multi-resolution decomposition, extracting and refining key features. Next, frequency attention and multi-domain blind deconvolution are employed to isolate critical components. The multi-head and multi-scale attention mechanisms are then incorporated into the network ' s backbone and neck modules to capture global dependencies and multi-scale information. Finally, a physically inspired loss function, data augmentation, and hyperparameter optimisation are applied to reinforce robustness and stability. Experimental results demonstrate that WaveFA-Net performs well across varying signal-to-noise ratios (SNR), proving its effectiveness in complex environments. © 2025 Elsevier B.V., All rights reserved.},
