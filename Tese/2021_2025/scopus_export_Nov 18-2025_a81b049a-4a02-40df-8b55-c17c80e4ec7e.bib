@CONFERENCE{Tulloh2024706,
	author = {Tulloh, Rohmat and Nana Rachmana, S. Rachmana and Mulyana, Eueung},
	title = {A Machine Learning Model for Predictive Signal Quality Assessment in Multichannel Optical Fiber Networks},
	year = {2024},
	pages = {706 - 711},
	doi = {10.1109/SCOReD64708.2024.10872655},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85219560500&doi=10.1109%2FSCOReD64708.2024.10872655&partnerID=40&md5=24e809795e39ff9461bc0611c8aa70c0},
	affiliations = {Institut Teknologi Bandung, Bandung, Indonesia; Telkom University, School of Applied Science, Bandung, Indonesia},
	abstract = {Optical fiber networks are susceptible to disruptions and failures that can degrade transmission quality and lead to data loss. Fluctuations in Bit Error Rate (BER) and Q Factor due to these issues impact signal quality, necessitating a predictive method for early detection and mitigation. This study proposes a proactive approach to predictive maintenance for multichannel optical networks using machine learning modeling to minimize transmission losses. We developed a predictive model based on a dataset generated through multichannel optical network simulations. These simulations incorporate parameters such as channel count, channel spacing, power, cable length, bitrate, frequency, OSNR, Q Factor, and BER. Predicted BER values are classified into ideal, maintenance, and repair categories. Several classification algorithms, including Naive Bayes, K-Nearest Neighbors (KNN), Support Vector Machine (SVM), Logistic Regression, and Artificial Neural Network (ANN), were evaluated. Simulation results indicate that the ANN model achieved the highest prediction accuracy of 98.7 % at a 90: 10 train-test ratio. Furthermore, the predictive system is accessible through PMFO, an intuitive web interface that enables real-time monitoring of multichannel networks and supports proactive maintenance decisions. This study establishes a foundation for predictive maintenance in multichannel optical networks, paving the way for real-world applications based on synthetic datasets. © 2025 Elsevier B.V., All rights reserved.},
	author_keywords = {Artificial Neural Network (ANN); Bit Error Rate (BER); Machine learning; Optical fiber network; Predictive maintenance; Q Factor Multichannel},
