@CONFERENCE{Ramanan20248811,
	author = {Ramanan, Buvaneswari A. and Khan, Manzoor Ahmed and Rao, Abhinav},
	title = {ASPIRE: A Multi-Agent Framework for Execution-Free Code Analysis and Repair},
	year = {2024},
	pages = {8811 - 8813},
	doi = {10.1109/BigData62323.2024.10825553},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85218002870&doi=10.1109%2FBigData62323.2024.10825553&partnerID=40&md5=74f0481491f05abcebbdcce911c0e24b},
	affiliations = {Nokia Bell Labs, Murray, United States; Carnegie Mellon University, Pittsburgh, United States},
	abstract = {The proliferation of Large Language Models (LLMs) and agentic systems for code generation introduces new challenges in ensuring the reliability and correctness of generated programs. Errors in dynamically generated code can cascade through workflows, leading to inefficiencies or failures in critical systems. We present ASPIRE, a multi-agent framework designed to address these challenges by providing execution-free static analysis and laying the foundation for program repair. ASPIRE's agents collaboratively simulate runtime traces, predict program states, and evaluate code correctness without requiring actual execution, making it particularly suited for LLM-generated code and agentic workflows. Experimental results on a curated dataset from Codeforces show ASPIRE achieving ~56% accuracy in verdict prediction, with a 33% improvement when employing multi-agent collaboration. While program repair remains an area of future work, ASPIRE demonstrates significant potential as a safeguard for dynamic, LLM-driven code generation systems. © 2025 Elsevier B.V., All rights reserved.},
	author_keywords = {Code Evaluation; Code Generation; Code Repair; Gemini; Generative AI; GPT; Large Language Models; Multi-agent frameworks; OpenAI; Software Engineering; Static Analysis},
	keywords = {Coding errors; Computer software selection and evaluation; Intelligent agents; Code evaluation; Code repair; Codegeneration; Geminus; Generative AI; GPT; Language model; Large language model; Multiagent framework; Openai; Artificial intelligence},
