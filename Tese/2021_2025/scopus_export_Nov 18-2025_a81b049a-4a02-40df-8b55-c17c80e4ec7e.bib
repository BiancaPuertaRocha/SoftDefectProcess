}

@ARTICLE{Nocera2022285,
	author = {Nocera, Fabrizio and Tabandeh, Armin and Gardoni Prof., Paolo},
	title = {Physics-Based Probabilistic Models for the Reliability Analysis of Bridges},
	year = {2022},
	journal = {Lecture Notes in Civil Engineering},
	volume = {200 LNCE},
	pages = {285 - 294},
	doi = {10.1007/978-3-030-91877-4_34},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85121928952&doi=10.1007%2F978-3-030-91877-4_34&partnerID=40&md5=2c35f23b6e2f06452489d00fecb84281},
	affiliations = {The Grainger College of Engineering, Urbana, United States},
	abstract = {This paper presents a general formulation for developing physics-based probabilistic models and explains their implementation in the reliability analysis of bridges and the modeling of their deterioration. The formulation of physics-based probabilistic models combines a computationally convenient representation of the governing physical laws with an analytical correction term. The governing physical laws may appear in the form of differential equations, design code expressions, or algorithmic procedures as in the push-over analysis. The correction term removes the implicit bias in predictions based on the governing physical laws and improves the model accuracy. A model error term is also included to capture the remaining unexplained uncertainty in model predictions. The physics-based probabilistic models predict the response quantities of interest (e.g., deformation capacity of a bridge) as a function of state variables that define the structural system, such as geometric quantities, material properties, initial and boundary conditions, and external loads. The paper presents stochastic differential equations for modeling the deterioration of the state variables based on thermodynamics laws. A reliability problem is then formulated to evaluate the time-varying failure probability using the developed probabilistic models. As an example, the paper presents a probabilistic model for the drift capacity of reinforced concrete bridge columns retrofitted with fiber-reinforced polymer composites and develops fragility functions conditioning on the drift demand. © 2021 Elsevier B.V., All rights reserved.},
	author_keywords = {Bayesian inference; Bridges; Deterioration; Probabilistic models; Reliability analysis},
	keywords = {Bayesian networks; Boundary conditions; Deterioration; Fiber reinforced plastics; Forecasting; Inference engines; Reinforced concrete; Stochastic models; Stochastic systems; Thermodynamics; Algorithmic procedure; Bayesian inference; Correction terms; Design codes; Physical laws; Physics-based; Prediction-based; Probabilistic models; Push-over analysis; State-variables; Reliability analysis},
	correspondence_address = {F. Nocera; Department of Civil and Environmental Engineering, University of Illinois at Urbana-Champaign, Urbana, United States; email: fnocera@illinois.edu},
	editor = {Pellegrino, C. and Faleschini, F. and Zanini, M.A. and Matos, J.C. and Casas, J.R. and Strauss, A.},
