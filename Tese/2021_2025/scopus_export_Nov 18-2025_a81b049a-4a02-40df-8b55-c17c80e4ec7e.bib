@CONFERENCE{Balami2024,
	author = {Balami, Ishaku Thlama and Okereke, Okpo U. and Anene, Ejike C. and Omizegba, Elijah Ehiagwina and Hassan, Aliyu and Garba, Ahmad I.},
	title = {Achievement of Optimum Power Transfer in Radio-Frequency Front-End Systems Through the Utilization of a Pattern Search-Based Impedance Matching Technique},
	year = {2024},
	pages = {},
	doi = {10.1109/ICIESTR60916.2024.10798157},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85215700378&doi=10.1109%2FICIESTR60916.2024.10798157&partnerID=40&md5=b48c456ad5b0b2b455828a5f6d3dff45},
	affiliations = {Abubakar Tafawa Balewa University, Department of Electrical and Electronic Engineering, Bauchi, Nigeria; Abubakar Tafawa Balewa University, Department of Mechanical Systems Engineering, Bauchi, Nigeria},
	abstract = {The paper proposes a practical method for tuning LC impedance matching networks in Wireless Power Transfer, achieving reliable convergence without complex mathematical modeling. Validation shows effectiveness with less than 0.2% antenna mismatch error, but further investigation is required for design considerations, by designing the matching network to be resilient against variations in load impedance, ambient conditions, and other external factors can enhance its reliability and stability. The focus is on optimizing lumped matching for Microstrip Patch Antennas (MPAs) to enhance performance, broaden bandwidth, and improve impedance matching, aiding researchers and engineers in overcoming design challenges and developing reliable antenna systems. A comparative analysis of 2-Elements Array antenna designs in a -10 dB signal scenario demonstrates that the optimal design strategy yields superior improvements in bandwidth and resonance frequencies. The classical design exhibited limited performance with zero bandwidth at 0.93 GHz (-7.5 dB), while the optimal design significantly extended the bandwidth to 40 MHz at 0.92 GHz (-25.7 dB). The classical design displayed a 30 MHz bandwidth at 1.56 GHz (-23.3 dB), while the optimal design maintained a 30 MHz bandwidth at 1.55 GHz (-24.7 dB). The results demonstrate consistent performance across a broad frequency spectrum ranging from 0.9 to 2.45 GHz. To confirm the validity of these findings, simulations were performed on the impedance matching circuit using predicted and calculated tuning parameters. The results validate that the antenna's resonance frequency, reflection coefficients, and operational 10-dB bandwidth demonstrate similar performance. The proposed shallow learning model, which is characterized by low complexity, showcases rapid prediction capabilities, making it well-suited for real-time applications. © 2025 Elsevier B.V., All rights reserved.},
	author_keywords = {Matching Network; MPA; MPT; Optimization; Smith Chart; WPT},
	keywords = {Antenna reflectors; Design for testability; Directional patterns (antenna); Impedance matching (acoustic); Impedance matching (electric); Inductive power transmission; Integrated circuit design; Linear programming; Nonlinear programming; Structural dynamics; Matching networks; Micro-strip patch antennas; Microstrip-patch antenna; MPT; Optimal design; Optimisations; Performance; Power transfers; Smith chart; WPT; Optimal systems},
