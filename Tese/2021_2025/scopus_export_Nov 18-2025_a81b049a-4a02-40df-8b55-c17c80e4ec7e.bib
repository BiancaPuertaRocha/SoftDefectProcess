}

@CONFERENCE{Lin2023443,
	author = {Lin, Tzuyang and Huang, Chinyu and Fang, Chihchiang},
	title = {Using the Deep Learning-Based Approaches for Program Debugging and Repair},
	year = {2023},
	pages = {443 - 454},
	doi = {10.1109/DSA59317.2023.00059},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85179512259&doi=10.1109%2FDSA59317.2023.00059&partnerID=40&md5=44ae8ddbe503b45659ce02d19a2fb57d},
	affiliations = {National Tsing Hua University, Hsinchu, Taiwan},
	abstract = {Maintenance is the most labor-intensive stage in the Software System Development Life Cycle (SDLC). When an error is detected, an Automatic Program Repair (APR) system can locate the error by utilizing fault prediction and then employ search-based or semantic-based repair techniques to attempt to fix it. Finally, the program repair system runs test cases to verify that the errors have been properly repaired and the program's functionality has not been compromised. In this study, we present a novel approach called Deep Learning Based GenProg (DLBGP), which combines deep learning with APR. Our proposed method involves extracting node vectors from the program's Abstract Syntax Tree (AST) and identifying semantic features using a Deep Brief Network (DBN). These semantic features are then used to predict the accuracy of the repair candidates. In experiments conducted on ten subject files in the IntroClass database, our proposed DLBGP model reduced execution time by 64% compared to GenProg while achieving the same number of successful test cases. In summary, we offer a fast, efficient, and easily deployable deep learning program repair method that could prove beneficial to the field of APR. © 2023 Elsevier B.V., All rights reserved.},
	author_keywords = {automatic program repair; deep brief network; deep learning; genetic programming; search-based repair},
	keywords = {Abstracting; Deep learning; Errors; Genetic programming; Life cycle; Repair; Semantic Web; Semantics; Software testing; Trees (mathematics); Automatic program repair; Automatic programs; Deep brief network; Learning-based approach; Repair system; Search-based; Search-based repair; Semantic features; Test case; Program debugging},
	correspondence_address = {C.-Y. Huang; National Tsing Hua University, Department of Computer Science, Hsinchu, Taiwan; email: cyhuang@cs.nthu.edu.tw},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	isbn = {9798350304770},
	language = {English},
	abbrev_source_title = {Proc. - Int. Conf. Dependable Syst. Their Appl., DSA},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1}
}

@CONFERENCE{Ye20231899,
	author = {Ye, He and Chen, Zimin and Le Goues, Claire},
	title = {PreciseBugCollector: Extensible, Executable and Precise Bug-Fix Collection: Solution for Challenge 8: Automating Precise Data Collection for Code Snippets with Bugs, Fixes, Locations, and Types},
	year = {2023},
	pages = {1899 - 1910},
	doi = {10.1109/ASE56229.2023.00163},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85179006191&doi=10.1109%2FASE56229.2023.00163&partnerID=40&md5=0ea84b69a0396b72a26ce18ad1ab95d9},
	affiliations = {Carnegie Mellon University, Pittsburgh, United States; The Royal Institute of Technology (KTH), Stockholm, Sweden},
	abstract = {Bug datasets are vital for enabling deep learning techniques to address software maintenance tasks related to bugs. However, existing bug datasets suffer from precise and scale limitations: they are either small-scale but precise with manual validation or large-scale but imprecise with simple commit message processing. In this paper, we introduce Precise-BugCollector, a precise, multi -language bug collection approach that overcomes these two limitations. PreciseBugCollector is based on two novel components: a) A bug tracker to map the codebase repositories with external bug repositories to trace bug type information, and b) A bug injector to generate project-specific bugs by injecting noise into the correct codebases and then executing them against their test suites to obtain test failure messages. We implement PreciseBugCollector against three sources: 1) A bug tracker that links to the national vulnerability data set (NVD) to collect general-wise vulnerabilities, 2) A bug tracker that links to OSS-Fuzz to collect general-wise bugs, and 3) A bug injector based on 16 injection rules to generate project-wise bugs. To date, PreciseBugCollector comprises 1057818 bugs extracted from 2968 open-source projects. Of these, 12602 bugs are sourced from bug repositories (NVD and OSS-Fuzz), while the remaining 1045216 project-specific bugs are generated by the bug injector. Considering the challenge objectives, we argue that a bug injection approach is highly valuable for the industrial setting, since project-specific bugs align with domain knowledge, share the same codebase, and adhere to the coding style employed in industrial projects. © 2023 Elsevier B.V., All rights reserved.},
	author_keywords = {Bug datasets; Program repair; Software testing and debugging},
	keywords = {Codes (symbols); Deep learning; Large dataset; Learning systems; Open source software; Software testing; Bug dataset; Bug fixes; Data collection; Data set; Executables; Learning techniques; Program repair; Small scale; Software Testing and Debugging; Software-maintenance tasks; Program debugging},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	isbn = {9798350329964},
	language = {English},
	abbrev_source_title = {Proc. - IEEE/ACM Int. Conf. Autom. Softw. Eng., ASE},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 3}
}

@CONFERENCE{An20232034,
	author = {An, Gabin and Kwon, Minhyuk and Choi, Kyunghwa and Yi, Jooyong and Yoo, Shin},
	title = {BUGSC++: A Highly Usable Real World Defect Benchmark for C/C++},
	year = {2023},
	pages = {2034 - 2037},
	doi = {10.1109/ASE56229.2023.00208},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85179006161&doi=10.1109%2FASE56229.2023.00208&partnerID=40&md5=9d60cd737c80c34440d960deb26798f6},
	affiliations = {Korea Advanced Institute of Science and Technology, Daejeon, South Korea; Suresoft Technologies, South Korea; UNIST, Earth, South Korea},
	abstract = {As software systems grow larger and more complex, debugging takes up an increasingly significant portion of developers' time and efforts during software maintenance. To aid software engineers in debugging, many automated debugging and repair techniques have been proposed. Both the development and evaluation of these automated techniques depend on benchmarks of bugs. While many different defect benchmarks have been developed, only a few benchmarks are widely used due to the origin of the collected bugs as well as the usability of the benchmarks themselves, risking a biased research landscape. This paper presents BUGSC++, a new benchmark that contains 209 real-world bugs collected from 22 open-source C/C++ projects. BugsC++ aims to provide high usability by providing a similar user interface to the widely used Defects4J. Further, BugsC++ ensures the replicability of the bugs in its collection by encapsulating each buggy program in a Docker container. By providing a highly usable real-world defect benchmark for C/C++, we hope to promote debugging research for C/C++. © 2023 Elsevier B.V., All rights reserved.},
	author_keywords = {bug; defect benchmark; fault; software testing},
	keywords = {C++ (programming language); Open source software; Program debugging; Software testing; User interfaces; Automated debugging; Automated techniques; Bug; Defect benchmark; Fault; Open-source; Real-world; Repair techniques; Software testings; Software-systems; Defects},
