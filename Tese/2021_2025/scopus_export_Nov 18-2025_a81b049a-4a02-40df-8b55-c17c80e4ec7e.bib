@CONFERENCE{Sivaranjani2023,
	author = {Sivaranjani, P. and Sasikala, S. and Lavanya, Allu and Keerthana, Mummaleti},
	title = {Design and Analysis of UART Protocol with Sec-Ded and Implementation on FPGA},
	year = {2023},
	pages = {},
	doi = {10.1109/ICCCNT56998.2023.10306744},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85179839475&doi=10.1109%2FICCCNT56998.2023.10306744&partnerID=40&md5=90d2afd3f61fc45c73ff63b306933997},
	affiliations = {Kongu Engineering College, Department of Electronics and Communication Engineering, Erode, India},
	abstract = {Universal Asynchronous Receiver/Transmitter (UART) is a widely adopted protocol for communication that finds its application in various domains such as microcontroller-based systems, embedded systems, and many others. This protocol is well suited for simple, low-cost, and low-speed communication between devices. One of the important aspects of UART communication is the reliability of the data being transmitted. In this regard, the Single Error Correction, Double Error Detection (SEC-DED) technique is critical for detecting and correcting errors that may occur during data transmission. The utilization of Hamming code in this technique enables the error detection and correction in the transmitted data, thus assuring the integrity and reliability of the data. Implementation of UART communication with the SEC-DED technique and evaluation of its performance in terms of error correction capability are performed with the help of a Basys 3 FPGA board. Furthermore, integrate the UART communication with a Universal Verification Methodology (UVM) environment, which provides a standard and reusable verification infrastructure for the verification of digital systems. The UVM environment enables us to test the UART communication with the SEC-DED technique in a controlled and systematic manner, as well as to validate its performance and functionality in a variety of test scenarios. In conclusion, a practical implementation of UART communication with the SEC-DED technique and its integration with the UVM environment for the verification of digital systems is performed. The results validate the effectiveness of the suggested implementation in ensuring the reliability of UART communication and highlight its potential for deployment in diverse domains. © 2023 Elsevier B.V., All rights reserved.},
	author_keywords = {FPGA; SEC-DED; UART; UVM; Verification},
	keywords = {Computer software reusability; Embedded systems; Error correction; Error detection; Integrated circuit design; Reliability; Design and analysis; Digital system; Error-detection techniques; Performance; Single error correction, double error detection; Single error corrections; Universal asynchronous receiver transmitters; Universal verification; Universal verification methodology; Verification methodology; Field programmable gate arrays (FPGA)},
	correspondence_address = {P. Sivaranjani; Kongu Engineering College, Department of Electronics and Communication Engineering, Perundurai, Tamil Nadu, India; email: sivaranjani.ece@kongu.edu},
